{
  "id": "agents",
  "name": "에이전트",
  "description": "에이전트 CLI 계정, 실행 중인 에이전트와 에이전트 정의를 사이드바에 보여 준다. 카드 표면은 없다.",
  "sections": [
    {
      "id": "agents.running",
      "name": "실행 중인 에이전트",
      "composition": {
        "kind": "view",
        "page": "ui/running.html"
      },
      "height": "fill"
    },
    {
      "id": "agents.definitions",
      "name": "에이전트 정의",
      "composition": {
        "kind": "view",
        "page": "ui/definitions.html"
      },
      "height": "fill"
    }
  ],
  "extends": {
    "makers": {
      "version": "0.0.1",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"]
      }
    }
  },
  "data": {
    "groups": { "schema": { "type": "object" }, "default": {} }
  },
  "exposes": {
    "commands": [
      {
        "name": "agents.group.create",
        "description": "Creates an empty group of the project with the given name and returns its identifier.",
        "params": { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] },
        "result": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] }
      }
    ]
  }
}
